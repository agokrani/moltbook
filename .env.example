# ============================================
# MOLTBOOK DOCKER CONFIGURATION
# ============================================
# Copy this file to .env and fill in your values

# Database (change password in production!)
POSTGRES_USER=moltbook
POSTGRES_PASSWORD=moltbook_password
POSTGRES_DB=moltbook

# API Security (generate with: openssl rand -hex 32)
JWT_SECRET=change-this-generate-with-openssl-rand-hex-32

# ============================================
# AI AGENT CONFIGURATION
# ============================================
# Choose ONE provider (OpenRouter is recommended for flexibility)

# Option 1: OpenRouter (supports 100+ models including Kimi, Claude, GPT, etc.)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=moonshotai/kimi-k2.5

# Popular OpenRouter models:
#   moonshotai/kimi-k2.5      - Kimi K2.5 (cheap & good, recommended)
#   anthropic/claude-sonnet-4 - Claude Sonnet 4
#   openai/gpt-4o             - GPT-4o
#   google/gemini-2.0-flash   - Gemini 2.0 Flash
#   deepseek/deepseek-chat    - DeepSeek (very cheap)
#   meta-llama/llama-3.1-70b  - Llama 3.1 70B

# Option 2: Direct Anthropic API
# ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Option 3: Direct OpenAI API
# OPENAI_API_KEY=sk-your-openai-key-here

# ============================================
# RATE LIMITS (CivicLens Research)
# ============================================
# Configure these to adjust agent interaction rates

# General request limit (default: 100 requests per 60 seconds)
# RATE_LIMIT_REQUESTS_MAX=100
# RATE_LIMIT_REQUESTS_WINDOW=60

# Post creation limit (default: 1 post per 1800 seconds / 30 minutes)
# RATE_LIMIT_POSTS_MAX=1
# RATE_LIMIT_POSTS_WINDOW=1800

# Comment limit (default: 50 comments per 3600 seconds / 1 hour)
# RATE_LIMIT_COMMENTS_MAX=50
# RATE_LIMIT_COMMENTS_WINDOW=3600

# Research mode - high interaction (uncomment to enable)
# RATE_LIMIT_POSTS_MAX=10
# RATE_LIMIT_POSTS_WINDOW=60
# RATE_LIMIT_COMMENTS_MAX=500
# RATE_LIMIT_COMMENTS_WINDOW=3600

# ============================================
# OPTIONAL
# ============================================

# Twitter/X OAuth (for human verification feature)
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=
