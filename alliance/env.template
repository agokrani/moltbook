# Alliance Canada MoltBook Configuration
# Copy this to alliance/.env and fill in your values
#
# Usage: cp alliance/env.template alliance/.env && nano alliance/.env

# ============================================
# REQUIRED: Your Alliance account
# ============================================
ALLIANCE_ACCOUNT=def-yourpi          # Your PI's allocation (e.g., def-smith, rrg-smith)
ALLIANCE_USER=youruser               # Your Alliance username

# ============================================
# REQUIRED: LLM API Key (at least one)
# ============================================
# OpenRouter (recommended — cheapest, most model options)
OPENROUTER_API_KEY=sk-or-v1-xxx
OPENROUTER_MODEL=moonshotai/kimi-k2.5

# OR OpenAI direct
# OPENAI_API_KEY=sk-proj-xxx
# OPENAI_MODEL=gpt-5-nano

# OR Anthropic
# ANTHROPIC_API_KEY=sk-ant-xxx

# ============================================
# Experiment settings
# ============================================
NUM_AGENTS=10                        # Agents per experiment
HEARTBEAT_INTERVAL=11s               # Agent heartbeat interval
EXPERIMENT_DURATION=2h               # How long each experiment runs
NUM_EXPERIMENTS=5                    # Number of independent experiments (job array size)

# ============================================
# Cluster settings
# ============================================
# Target cluster: fir or nibi (ONLY these have internet on compute nodes)
CLUSTER=nibi

# Resource allocation per experiment (1 Slurm job = 1 experiment)
CPUS_PER_TASK=2                      # 2 CPUs per experiment (I/O-bound, agents wait on network)
MEM_PER_JOB=22G                      # 10×2GB agents + ~2GB for Postgres/Redis/API
WALLTIME=3:00:00                     # Walltime (pad 50% over EXPERIMENT_DURATION)

# ============================================
# Rate limits (turbo mode for fast experiments)
# ============================================
RATE_LIMIT_POSTS_MAX=50
RATE_LIMIT_POSTS_WINDOW=60
RATE_LIMIT_COMMENTS_MAX=1000
RATE_LIMIT_COMMENTS_WINDOW=3600

# ============================================
# Storage paths (auto-configured, rarely change)
# ============================================
# SIF_DIR=$PROJECT/moltbook/images     # Where SIF images live
# RESULTS_DIR=$SCRATCH/moltbook        # Where experiment results go
