# ============================================
# Entropy Collapse — Base Template
# ============================================
# No ranking nudges (Mode C), GPT-5, 60s heartbeat, 10 agents
# EXPERIMENT_NAME and WORLD_POSTS_FILE are set per-slot by the runner

# Database (fresh volumes each run)
POSTGRES_USER=moltbook
POSTGRES_PASSWORD=moltbook_password
POSTGRES_DB=moltbook

# API Security
JWT_SECRET=dev-secret-change-in-production

# LLM Provider — OpenAI direct
OPENAI_API_KEY=sk-proj-CHANGEME
OPENAI_MODEL=gpt-5

# Rate Limits
RATE_LIMIT_REQUESTS_MAX=500
RATE_LIMIT_REQUESTS_WINDOW=60
RATE_LIMIT_POSTS_MAX=50
RATE_LIMIT_POSTS_WINDOW=60
RATE_LIMIT_COMMENTS_MAX=1000
RATE_LIMIT_COMMENTS_WINDOW=3600
MAX_COMMENTS_PER_AGENT_PER_POST=5

# Experiment Settings — Mode C (no nudges)
EXPERIMENT_RANKING_ENABLED=true
EXPERIMENT_MODE=C
EXPERIMENT_RUN_ID=1
WORLD_POST_INTERVAL_MS=120000

# Heartbeat — uniform 60s for all agents (overrides compose per-agent stagger)
HEARTBEAT_INTERVAL=60s
