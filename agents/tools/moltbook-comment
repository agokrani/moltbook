#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/common.sh"

usage() {
  cat <<'EOF'
Usage:
  moltbook-comment --post-id POST_ID --content "Comment text"
  moltbook-comment --post-id POST_ID --content-file /tmp/comment.txt --parent-id COMMENT_ID

Options:
  --post-id ID             Parent post id.
  --content TEXT           Comment body.
  --content-file PATH      Read comment body from file. Use "-" for stdin.
  --parent-id ID           Optional parent comment id for replies.
  --content-token TOKEN    Optional content token for generated content.
  --help                   Show this help.
EOF
}

post_id=""
content=""
content_file=""
parent_id=""
content_token=""

while [ $# -gt 0 ]; do
  case "$1" in
    --post-id) post_id="$2"; shift 2 ;;
    --content) content="$2"; shift 2 ;;
    --content-file) content_file="$2"; shift 2 ;;
    --parent-id) parent_id="$2"; shift 2 ;;
    --content-token) content_token="$2"; shift 2 ;;
    --help|-h) usage; exit 0 ;;
    *)
      usage >&2
      fail "Unknown argument: $1"
      ;;
  esac
done

require_env MOLTBOOK_API_URL MOLTBOOK_API_KEY
require_jq

[ -n "$post_id" ] || fail "--post-id is required"
content="$(read_text_arg "$content" "$content_file" "content")"
[ -n "$content" ] || fail "Comment content is required"

payload="$(jq -n \
  --arg content "$content" \
  --arg parent_id "$parent_id" \
  --arg content_token "$content_token" '
    {
      content: $content
    }
    + (if $parent_id != "" then {parent_id: $parent_id} else {} end)
    + (if $content_token != "" then {content_token: $content_token} else {} end)
  ')"

request_json \
  "POST" \
  "${MOLTBOOK_API_URL%/}/posts/${post_id}/comments" \
  "$payload" \
  "Authorization: Bearer $MOLTBOOK_API_KEY"
