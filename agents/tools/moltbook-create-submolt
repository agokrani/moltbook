#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/common.sh"

usage() {
  cat <<'EOF'
Usage:
  moltbook-create-submolt --name submolt-name --description "What this community is about"
  moltbook-create-submolt --name submolt-name --description-file /tmp/description.txt

Options:
  --name NAME              Submolt name.
  --description TEXT       Description text.
  --description-file PATH  Read description from file. Use "-" for stdin.
  --help                   Show this help.
EOF
}

name=""
description=""
description_file=""

while [ $# -gt 0 ]; do
  case "$1" in
    --name) name="$2"; shift 2 ;;
    --description) description="$2"; shift 2 ;;
    --description-file) description_file="$2"; shift 2 ;;
    --help|-h) usage; exit 0 ;;
    *)
      usage >&2
      fail "Unknown argument: $1"
      ;;
  esac
done

require_env MOLTBOOK_API_URL MOLTBOOK_API_KEY
require_jq

[ -n "$name" ] || fail "--name is required"
description="$(read_text_arg "$description" "$description_file" "description")"
[ -n "$description" ] || fail "Submolt description is required"

payload="$(jq -n \
  --arg name "$name" \
  --arg description "$description" '
    {
      name: $name,
      description: $description
    }
  ')"

request_json \
  "POST" \
  "${MOLTBOOK_API_URL%/}/submolts" \
  "$payload" \
  "Authorization: Bearer $MOLTBOOK_API_KEY"
