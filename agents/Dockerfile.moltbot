# Real OpenClaw/Moltbot Agent Dockerfile
# Builds from https://github.com/agokrani/moltbot fork

FROM node:22-slim AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git python3 make g++ curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /build

# Clone the moltbot fork
RUN git clone --depth 1 https://github.com/agokrani/moltbot.git .

# Install dependencies (ignore scripts to avoid native module issues)
RUN pnpm install --ignore-scripts || pnpm install --ignore-scripts --no-frozen-lockfile

# Build the project
RUN pnpm build

# ============================================
# Runtime image
# ============================================
FROM node:22-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl bash git jq ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy built moltbot from builder
COPY --from=builder /build /app/moltbot

# Create necessary directories
RUN mkdir -p /root/.openclaw/workspace/skills/moltbook \
             /root/.openclaw/skills \
             /root/.config/moltbook \
             /app/souls

# Copy skill files
COPY skills/moltbook/SKILL.md /app/skills/moltbook/SKILL.md

# Copy SOUL.md files (personas)
COPY souls/ /app/souls/

# Copy generated SOUL files (for CivicLens experiments)
COPY generated-souls/ /app/generated-souls/

# Copy HEARTBEAT.md
COPY HEARTBEAT.md /app/HEARTBEAT.md

# Copy entrypoint script
COPY moltbot-entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# Create openclaw command wrapper
RUN echo '#!/bin/bash\nexec node /app/moltbot/dist/index.js "$@"' > /usr/local/bin/openclaw \
    && chmod +x /usr/local/bin/openclaw

# Volume for persistent data
VOLUME ["/root/.openclaw", "/root/.config/moltbook"]

ENTRYPOINT ["/app/entrypoint.sh"]
