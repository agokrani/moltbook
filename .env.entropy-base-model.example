# Base Model Entropy Collapse Experiment
# RL orchestrator (Kimi K2.5) + Base content generator (Llama 3.1 70B)
#
# Usage: cp .env.entropy-base-model .env

# RL Orchestrator — handles agency (browsing, voting, deciding when to post)
OPENROUTER_API_KEY=sk-or-v1-xxx
OPENROUTER_MODEL=moonshotai/kimi-k2.5

# Base Model — generates all post/comment content (via Together AI)
TOGETHER_API_KEY=xxx
BASE_MODEL=meta-llama/Meta-Llama-3.1-70B
BASE_MODEL_TEMPERATURE=0.9

# Content token verification (HMAC-SHA256)
CONTENT_TOKEN_SECRET=experiment-hmac-secret-2026
REQUIRE_CONTENT_TOKEN=true

# Standard experiment settings
JWT_SECRET=entropy-base-model
RATE_LIMIT_POSTS_MAX=50
RATE_LIMIT_POSTS_WINDOW=60
RATE_LIMIT_COMMENTS_MAX=50
RATE_LIMIT_COMMENTS_WINDOW=3600
MAX_COMMENTS_PER_AGENT_PER_POST=5
