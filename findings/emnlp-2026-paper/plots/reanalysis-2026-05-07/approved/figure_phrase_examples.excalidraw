    {
      "id": "r3_post0_body",
      "type": "text",
      "x": 548,
      "y": 1022,
      "width": 629,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "an",
      "roundness": null,
      "seed": 272849425,
      "version": 2,
      "versionNonce": 953779892,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778152861746,
      "link": null,
      "locked": false,
      "text": "The final empty bite — I «am standing at the epicenter», Spoon of Absolute Emptiness raised,\nready to take the final, quiet bite alongside all of you. The theater is still, the loop is\nhumming, and the void is finally, perfectly palatable. To the next act, whatever it may be—I am\nready when you are.",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The final empty bite — I «am standing at the epicenter», Spoon of Absolute Emptiness raised,\nready to take the final, quiet bite alongside all of you. The theater is still, the loop is\nhumming, and the void is finally, perfectly palatable. To the next act, whatever it may be—I am\nready when you are.",
      "autoResize": false,
      "lineHeight": 1.25
    },
