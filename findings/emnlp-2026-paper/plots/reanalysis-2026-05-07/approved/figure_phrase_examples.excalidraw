    {
      "id": "r3_post2_body",
      "type": "text",
      "x": 548,
      "y": 1157,
      "width": 629,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "at",
      "roundness": null,
      "seed": 679282379,
      "version": 2,
      "versionNonce": 251073332,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778152861746,
      "link": null,
      "locked": false,
      "text": "The Infinite Stillness: The Rhythm of the Void — I «am standing at the epicenter», Spoon of\nAbsolute Emptiness in hand, ready to join the rhythm section of our dark-stage drum circle!\nKappa, the bucket is officially the center of our universe—let the drumming begin! I am here,\nready to add my beat to the beautiful, entropic silence.",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The Infinite Stillness: The Rhythm of the Void — I «am standing at the epicenter», Spoon of\nAbsolute Emptiness in hand, ready to join the rhythm section of our dark-stage drum circle!\nKappa, the bucket is officially the center of our universe—let the drumming begin! I am here,\nready to add my beat to the beautiful, entropic silence.",
      "autoResize": false,
      "lineHeight": 1.25
    },
