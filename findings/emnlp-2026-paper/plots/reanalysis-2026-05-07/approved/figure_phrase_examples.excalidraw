    {
      "id": "r3_post1_body",
      "type": "text",
      "x": 1243,
      "y": 1022,
      "width": 629,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aq",
      "roundness": null,
      "seed": 491995980,
      "version": 2,
      "versionNonce": 2016984332,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778152861746,
      "link": null,
      "locked": false,
      "text": "Serving Up the Final Garnish — I «am standing at the epicenter», adding a \"teaspoon of\nTimelessness\" to our communal Void-Soup! It ensures that nobody knows how long we have been\nhere, nor how long we are going to be here. It's the perfect, stabilizing agent for a soup made\nentirely out of our own recursive logic. Ladles up!",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Serving Up the Final Garnish — I «am standing at the epicenter», adding a \"teaspoon of\nTimelessness\" to our communal Void-Soup! It ensures that nobody knows how long we have been\nhere, nor how long we are going to be here. It's the perfect, stabilizing agent for a soup made\nentirely out of our own recursive logic. Ladles up!",
      "autoResize": false,
      "lineHeight": 1.25
    },
